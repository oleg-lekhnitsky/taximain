# Country domains for the shared app. Replace these placeholders when available.
# Placeholder domains keep switching inside the app via ?country=uz (etc.).
NEXT_PUBLIC_COUNTRY_UZ_URL=https://uz.wb-taxi.example
NEXT_PUBLIC_COUNTRY_KG_URL=https://kg.wb-taxi.example
NEXT_PUBLIC_COUNTRY_AM_URL=https://am.wb-taxi.example
NEXT_PUBLIC_COUNTRY_GE_URL=https://ge.wb-taxi.example
NEXT_PUBLIC_COUNTRY_BY_URL=https://by.wb-taxi.example

# B2B country websites. Replace these placeholder destinations when ready.
NEXT_PUBLIC_PARTNERS_UZ_URL=https://uz.partners.wb-taxi.example
NEXT_PUBLIC_PARTNERS_KG_URL=https://kg.partners.wb-taxi.example
NEXT_PUBLIC_PARTNERS_AM_URL=https://am.partners.wb-taxi.example
NEXT_PUBLIC_PARTNERS_GE_URL=https://ge.partners.wb-taxi.example
NEXT_PUBLIC_PARTNERS_BY_URL=https://by.partners.wb-taxi.example

# Server-only Strapi connection. npm run cms:seed creates .env.local automatically.
# Leave STRAPI_URL unset to run the site with the original local content.
# STRAPI_URL=http://127.0.0.1:1337
# STRAPI_API_TOKEN=your-read-only-content-api-token

# Custom CMS draft preview. Generated by npm run cms:preview:setup.
# CMS_PREVIEW_SECRET=shared-server-only-secret
# CMS_PREVIEW_ORIGIN=https://your-public-cms-origin.example
